{
	"id": "skills",
	"version": "1.0.0",
	"name": "Agent Skills",
	"description": "Installs agent skills via `pnpm dlx skills add`",
	"options": {
		"skills": {
			"type": "string",
			"default": "",
			"description": "Comma-separated sources passed to `skills add` (e.g. vercel-labs/agent-skills,anthropics/skills)"
		},
		"agent": {
			"type": "string",
			"default": "claude-code",
			"description": "Target agent passed to `skills add --agent`"
		}
	},
	"installsAfter": [
		"ghcr.io/devcontainers/features/node"
	]
}
